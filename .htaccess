# Wessling Familienarchiv — Servereinstellungen für public_html

# 1) Startseite über index.php ausliefern (schreibt den Protokolleintrag und
#    liefert danach die unveränderte index.html aus).
DirectoryIndex index.php index.html

# 2) Immer die aktuelle Archivfassung ausliefern (kein veralteter Browser-Cache)
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 3) Eine Adresse für alle: www.wessling-family.com dauerhaft auf
#    wessling-family.com umleiten. Wichtig, damit Browser-Speicher
#    (gemerktes Passwort, Admin-Änderungen) immer am selben Ort liegt.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
